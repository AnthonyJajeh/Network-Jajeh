clear; clc; close all

% Parameters
mgL_to_kgm3 = 1e-3;
n_sweep = 10;
EPS_sweep = linspace(0,1500,n_sweep);
avg_nutrient_EPS_sweep = zeros(n_sweep,1);

k_eff_sweep = zeros(n_sweep,1);
k_eff_norm_sweep = zeros(n_sweep,1);
mean_open_area_sweep = zeros(n_sweep,1);

D_B = 1e-9; %m^2/s
D_E = 1e-10; %m^2/s
lambda = .05;  %lambda = eta
N0 = 0.2    * mgL_to_kgm3;   % [kg N/m^3], paper: 0.2 mg N/L
mu_fluid = 1.8e-3;   % viscosity [Pa*s]

N_B = 10;     % number of brine radial nodes
N_E = 20;     % number of EPS radial nodes
N_x = 10;     % number of axial nodes

vf0_values = [0.05 0.10 .15 .20 .25];
n_vf = length(vf0_values);

k_eff_vf_EPS = zeros(n_vf, n_sweep);
avg_nutrient_vf_EPS = zeros(n_vf, n_sweep);
mean_open_area_vf_EPS = zeros(n_vf, n_sweep);
sigma_A = .25;
n_cols = 3; %number of column
n_pipes_per_col=10; %number of pipes per column
n_pipes = n_cols*n_pipes_per_col; %total number of pipes
height_stretch=1;
for j = 1:n_vf
    vf0_current = vf0_values(j);
      fprintf('\n=============================================\n');
    fprintf('Running volume fraction phi = %.3f (%d of %d)\n', ...
        vf0_current, j, n_vf);
    fprintf('=============================================\n');
    
    am0 = pi*(7.e-5 + 1.6e-4*vf0_current)^2; %[m^2]
    mu_A = log(am0)-.5*sigma_A^2;


    
    A = (exp(mu_A+sigma_A*randn(1,n_pipes)))'; %initial total pipe are
    a = sqrt(A/pi);  %lognormal distribution of radius of pipes
    L   = sqrt((2 * am0) / vf0_current);
    rho_EPS = 1500;
    A_base = A;
    a_base = sqrt(A_base/pi);

    % =========================================================
    % CHOOSE EPS VALUES TO VISUALIZE AS COLUMN PLOTS
    % =========================================================
    % =========================================================
    % SET UP PIPE COLUMN PLOTS FOR EVERY EPS RUN
    % =========================================================
    
    % Use common radial plotting width based on largest EPS amount
    % Since EPS clogs inward, the outer pore radius stays fixed
    R_base = sqrt(A_base/pi);
    Rmax_global = max(R_base);
    
    Nr_plot = 120;
    r_plot_global = linspace(-Rmax_global, Rmax_global, Nr_plot);
  

    % Automatically choose subplot layout based on number of EPS runs
    n_plot_rows = ceil(sqrt(n_sweep));
    n_plot_cols = ceil(n_sweep / n_plot_rows);
    
    fig_pipes = figure('Position',[50 50 1600 1000]);
    
    tl_pipes = tiledlayout(fig_pipes, n_plot_rows, n_plot_cols, ...
        'TileSpacing','compact', ...
        'Padding','compact');
    title(tl_pipes, sprintf('PDE nutrient fields, \\phi = %.2f', vf0_current), ...
    'FontSize', 16, ...
    'FontWeight', 'bold');
% =========================================================
% PDE EPS deposition using SAME rule as network model
% =========================================================


% =========================================================
% STORE AVERAGE EPS-LAYER NUTRIENT PROFILE FOR EACH EPS RUN
% =========================================================
n_plot_dense = 800;
x_dense_common = linspace(0, n_pipes_per_col*L, n_plot_dense);

E_mean_all_EPS = zeros(n_sweep, n_plot_dense);
E_by_col_all_EPS = zeros(n_sweep, n_cols, n_plot_dense);

for s = 1:n_sweep
    EPS_amount = EPS_sweep(s);

fprintf('\nRunning PDE for EPS = %.3f kg/m^3 (%d of %d)\n', ...
    EPS_amount, s, n_sweep);

% ---------------------------------------------------------
% SAME EPS INTRODUCTION AS NETWORK MODEL
% Incremental EPS is added to the current open geometry.
% ---------------------------------------------------------
    A_open_raw = A_base *(max(1-EPS_amount/rho_EPS,0));
    
        min_brine_radius = 1e-8;     % [m] numerical floor for nearly clogged pipes
        min_EPS_thick    = 1e-7;   
         R = sqrt(A_base/pi); 
          % Physical open area for plotting
    A_open_phys = max(A_open_raw, 0);
    
    % Physical brine radius for plotting
    a_disp = sqrt(A_open_phys/pi);
    
    % If fully clogged, show no brine core
    a_disp(A_open_phys <= 0) = 0;
    
    % Numerical open area for PDE solve
    A_open = max(A_open_raw, pi*min_brine_radius^2);
    
    % Numerical brine radius
    a = sqrt(A_open/pi);
    
    % Force a tiny EPS layer only for PDE numerics
    a = min(a, R - min_EPS_thick);
    
    % Safety
    a = max(a, min_brine_radius);        
    
        
        mean_open_area_sweep(s) = mean(A_open_phys);
        mean_open_area_vf_EPS(j,s) = mean_open_area_sweep(s);

% =========================================================
% BUILD RADIAL GRIDS AND PRESSURE-DRIVEN VELOCITY PROFILES
% FOR STACKED VERTICAL COLUMNS
% =========================================================

r_B = zeros(N_B, n_pipes);
r_E = zeros(N_E, n_pipes);
u   = zeros(N_B, n_pipes);

Delta_r_B = zeros(1,n_pipes);
Delta_r_E = zeros(1,n_pipes);

Delta_x = L/(N_x-1);
x_local = linspace(0,L,N_x);

% Total pressure drop from bottom to top of each vertical column
p_drop = 1;  % [Pa]

u_max_pipe = zeros(n_pipes,1);
Q_col = zeros(n_cols,1);
R_col_all = zeros(n_cols,1);

% ---------------------------------------------------------
% Each column is a stack of pipes in series.
% Same Q through all pipes in one column.
% Same total pressure drop p_drop across each column.
% ---------------------------------------------------------
for c = 1:n_cols

    R_col = 0;

    % Total hydraulic resistance of this column
    for q = 1:n_pipes_per_col

        p = (c-1)*n_pipes_per_col + q;

       if A_open_raw(p) <= 0
            R_pipe = Inf;
        else
            a_flow = sqrt(A_open_raw(p)/pi);   % physical radius, no numerical floor
            R_pipe = 8*mu_fluid*L/(pi*a_flow^4);
        end
        
        R_col = R_col + R_pipe;

    end
    R_col_all(c) = R_col;
    % Flow rate through this column
        if isinf(R_col) || R_col <= 0
            Q_col(c) = 0;
        else
            Q_col(c) = p_drop / R_col;
        end
    % Convert column flow rate into pipe-specific u_max
    for q = 1:n_pipes_per_col

        p = (c-1)*n_pipes_per_col + q;

    if A_open_raw(p) <= 0 || Q_col(c) == 0
        U_avg_pipe = 0;
    else
        A_pipe_phys = A_open_raw(p);
        U_avg_pipe = Q_col(c) / A_pipe_phys;
    end
    
    u_max_pipe(p) = 2*U_avg_pipe;
    end

end
% =========================================================
% EFFECTIVE PERMEABILITY FROM PDE FLOW FIELD
% =========================================================
% Darcy law:
%   Ubar = -(k/mu) * (DeltaP / D_total)
%
% Rearranged:
%   k = mu * Ubar * D_total / DeltaP
%
% Here:
%   Q_total = sum flow through all columns [m^3/s]
%   A_sample = total cross-sectional area of sample [m^2]
%   Ubar = Q_total / A_sample [m/s]
% =========================================================

D_total = n_pipes_per_col * L;   % total vertical height [m]
A_sample = n_cols * L^2;         % sample cross-sectional area [m^2]

Q_total = sum(Q_col);            % total flow through PDE column system [m^3/s]
Ubar = Q_total / A_sample;       % Darcy-scale average velocity [m/s]

k_eff_sweep(s) = mu_fluid * Ubar * D_total / p_drop;  % [m^2]

k_eff_vf_EPS(j,s) = k_eff_sweep(s);

if s == 1
    k_eff_norm_sweep(s) = 1;
else
    k_eff_norm_sweep(s) = k_eff_sweep(s) / k_eff_sweep(1);
end

fprintf('PDE effective permeability for EPS = %.3f kg/m^3 is %.6e m^2\n', ...
    EPS_amount, k_eff_sweep(s));
% ---------------------------------------------------------
% Build radial grids and velocity profile for each pipe
% ---------------------------------------------------------
for p = 1:n_pipes

    Delta_r_B(p) = a(p)/(N_B-1);
    Delta_r_E(p) = (R(p)-a(p))/(N_E-1);

    r_B(:,p) = linspace(0,a(p),N_B)';
    r_E(:,p) = linspace(a(p),R(p),N_E)';

    % Pressure-driven Poiseuille velocity profile
    u(:,p) = u_max_pipe(p)*(1 - (r_B(:,p)/a(p)).^2);

end

%Initial condition concentrations 
C_in  = .01;

params.a= a;
params.R = R;
params.D_B = D_B;
params.D_E = D_E;
params.lambda = lambda;
params.L = L;

params.C_in = C_in;
params.JE_out =  1e-11;
params.JB_out =  1e-10;
params.N_B = N_B;
params.N_E = N_E;
params.N_x = N_x;
params.n_cols = n_cols;
params.n_pipes_per_col = n_pipes_per_col;
params.n_pipes = n_pipes;

params.Delta_r_B = Delta_r_B;
params.Delta_r_E = Delta_r_E;
params.Delta_x   = Delta_x;

params.r_B = r_B;
params.r_E = r_E;
params.u   = u;

% Initial conditions
n_B = (N_B-1)*(N_x-2);
n_E = (N_E-1)*(N_x-2);


% Stack into one long vector
y0 = zeros(n_pipes*(n_B+n_E),1);

tspan = linspace(0,5000,15);
steady_tol = 1e-6;

n_pipe_state = n_B + n_E;
n_col_state  = n_pipes_per_col*n_pipe_state;

% ---------------------------------------------------------
% Faster Jacobian sparsity pattern
% Each pipe depends mostly on itself.
% Pipe q also depends on pipe q-1 through the inlet boundary.
% This is much sparser than making the whole column dense.
% ---------------------------------------------------------
J_col = sparse(n_col_state,n_col_state);

Ppipe = spones(sparse(ones(n_pipe_state,n_pipe_state)));

for q = 1:n_pipes_per_col

    idx_q = (q-1)*n_pipe_state + (1:n_pipe_state);

    % Pipe q depends on itself
    J_col(idx_q,idx_q) = Ppipe;

    % Pipe q depends on previous pipe through boundary condition
    if q > 1
        idx_prev = (q-2)*n_pipe_state + (1:n_pipe_state);
        J_col(idx_q,idx_prev) = Ppipe;
    end

end

% Columns are independent, so use block diagonal structure
J_pat = kron(speye(n_cols),J_col);

opts = odeset( ...
    'RelTol',1e-4, ...
    'AbsTol',1e-6, ...
    'JPattern',J_pat, ...
    'Events', @(t,y) steady_state_event(t,y,params,steady_tol));
tic
[t,y,te,ye,ie] = ode15s(@(t,y) pde_rhs(t,y,params), tspan, y0, opts);
toc
% Final time solution
% Final time solution

if ~isempty(te)
    fprintf('Steady state reached at t = %.6g\n', te(end));
else
    fprintf('Steady state not reached by final time t = %.6g\n', t(end));
end

dydt_final = pde_rhs(t(end), y(end,:)', params);
fprintf('Final ||dy/dt||_inf = %.6e\n', norm(dydt_final, inf));
y_m = y(end,:)';
% Save PDE geometry before permeability sweep changes L
L_pde = params.L;
Delta_x_pde = params.Delta_x;
x_local_pde = linspace(0,L_pde,N_x);
fprintf('\n--- Exact boundary check from plotting reconstruction ---\n');
nutrient_EPS_pipe = zeros(n_pipes,1);

% =========================================================
% PLOT COLUMN FOR THIS EPS VALUE
% One tile per EPS run
% =========================================================
nexttile(tl_pipes);
hold on

Rmax = Rmax_global;
r_plot = r_plot_global;

col_spacing = 3.0*Rmax;

y_n = y(end,:)';

% Full vertical grid for one column
y_full = [];

for q = 1:n_pipes_per_col

    y_pipe = x_local_pde + (q-1)*L_pde;

    if q == 1
        y_full = [y_full, y_pipe];
    else
        y_full = [y_full, y_pipe(2:end)];
    end

end

% Build and plot each column
cmin_t = inf;
cmax_t = -inf;
F_cols = cell(n_cols,1);

for c = 1:n_cols

    prev_out = [];
    F_col = [];

    for q = 1:n_pipes_per_col

        p = (c-1)*n_pipes_per_col + q;

        offset = (p-1)*(n_B+n_E);

        B_stored = reshape(y_n(offset + (1:n_B)), N_B-1, N_x-2);
        E_stored = reshape(y_n(offset + n_B + (1:n_E)), N_E-1, N_x-2);

        drB = Delta_r_B(p);
        drE = Delta_r_E(p);

        outF = build_display_field_full_direct(B_stored, E_stored, ...
            r_B(:,p), r_E(:,p), a_disp(p), R(p), r_plot, ...
            D_B, D_E, drB, drE, q, n_pipes_per_col, ...
            prev_out, params.C_in, params.JB_out, params.JE_out, Delta_x_pde);

        F = outF.field;

        if q == 1
            F_col = [F_col; F];
        else
            F_col = [F_col; F(2:end,:)];
        end

        prev_out = outF;

    end

    F_cols{c} = F_col;

    cmin_t = min(cmin_t, min(F_col(:), [], 'omitnan'));
    cmax_t = max(cmax_t, max(F_col(:), [], 'omitnan'));

end

% Plot all columns for this EPS value
for c = 1:n_cols

  x_shift = (c-1)*col_spacing;

    F_col = F_cols{c};

    % Convert horizontal coordinate from meters to micrometers
    r_plot_shifted_um = 1e6 * (r_plot + x_shift);

    % Convert vertical coordinate from meters to millimeters
    y_full_mm = 1e3 * height_stretch * y_full;

    imagesc(r_plot_shifted_um, y_full_mm, F_col);
    set(gca,'YDir','normal');

    shading interp

    % Draw pipe walls/interface
    for q = 1:n_pipes_per_col

        p = (c-1)*n_pipes_per_col + q;

       % Convert vertical coordinate to millimeters
        y0 = 1e3 * height_stretch * ((q-1)*L_pde);
        y1 = 1e3 * height_stretch * (q*L_pde);
        
        % Convert horizontal wall/interface positions to micrometers
        plot(1e6*(x_shift + [ a_disp(p)  a_disp(p)]), [y0 y1], 'w--', 'LineWidth', 0.5);
        plot(1e6*(x_shift + [-a_disp(p) -a_disp(p)]), [y0 y1], 'w--', 'LineWidth', 0.5);
        
        plot(1e6*(x_shift + [ R(p)  R(p)]), [y0 y1], 'k-', 'LineWidth', 0.5);
        plot(1e6*(x_shift + [-R(p) -R(p)]), [y0 y1], 'k-', 'LineWidth', 0.5);
    end

end

axis tight

xlim(1e6 * [-Rmax, (n_cols-1)*col_spacing + Rmax]);
ylim(1e3 * height_stretch * [0, n_pipes_per_col*L_pde]);
if isfinite(cmin_t) && isfinite(cmax_t)
    if cmax_t > cmin_t
        caxis([cmin_t cmax_t]);
    else
        caxis([cmin_t cmin_t + 1e-12]);
    end
end

title(sprintf('\\phi = %.2f, EPS = %.0f kg/m^3', vf0_current, EPS_amount), ...
    'FontSize', 8);

% Make the tiled plot less crowded
xlabel('horizontal position [\mum]');
ylabel('vertical distance [mm]');

set(gca, ...
    'XTickMode','auto', ...
    'YTickMode','auto', ...
    'XTickLabelMode','auto', ...
    'YTickLabelMode','auto', ...
    'FontSize',8);
box on

hold off
for c = 1:n_cols

    prev_out = [];

    for q = 1:n_pipes_per_col

        p = (c-1)*n_pipes_per_col + q;

        offset = (p-1)*(n_B+n_E);

        B_stored = reshape(y_m(offset + (1:n_B)), N_B-1, N_x-2);
        E_stored = reshape(y_m(offset + n_B + (1:n_E)), N_E-1, N_x-2);

        drB = Delta_r_B(p);
        drE = Delta_r_E(p);

        outF = build_display_field_full_direct(B_stored, E_stored, ...
            r_B(:,p), r_E(:,p), a_disp(p), R(p), [], ...
            D_B, D_E, drB, drE, q, n_pipes_per_col, ...
            prev_out, params.C_in, params.JB_out, params.JE_out, Delta_x_pde);

        % E_full(1,:) is the interface.
        % E_full(2:end,:) is the EPS layer.
        nutrient_EPS_pipe(p) = mean(outF.E_full(2:end,:), 'all');

        prev_out = outF;

    end
end
avg_nutrient_EPS_sweep(s) = mean(nutrient_EPS_pipe);
avg_nutrient_vf_EPS(j,s) = avg_nutrient_EPS_sweep(s);
fprintf('Average EPS-layer nutrient for EPS = %.3f is %.6e\n', ...
    EPS_amount, avg_nutrient_EPS_sweep(s));

% =========================================================
% STORE EPS-LAYER NUTRIENT PROFILE FOR THIS EPS VALUE
% Average each column, then average over all columns
% =========================================================

x_dense_common = linspace(0, n_pipes_per_col*L_pde, n_plot_dense);
E_by_col_dense = zeros(n_cols, n_plot_dense);

for c = 1:n_cols

    x_all = [];
    E_all = [];

    prev_out = [];

    for q = 1:n_pipes_per_col

        p = (c-1)*n_pipes_per_col + q;

        offset = (p-1)*(n_B+n_E);

        B_stored = reshape(y_m(offset + (1:n_B)), N_B-1, N_x-2);
        E_stored = reshape(y_m(offset + n_B + (1:n_E)), N_E-1, N_x-2);

        drB = Delta_r_B(p);
        drE = Delta_r_E(p);

        outF = build_display_field_full_direct(B_stored, E_stored, ...
            r_B(:,p), r_E(:,p), a_disp(p), R(p), [], ...
            D_B, D_E, drB, drE, q, n_pipes_per_col, ...
            prev_out, params.C_in, params.JB_out, params.JE_out, Delta_x_pde);

        % Average over EPS layer only, excluding interface row
        E_avg_full = mean(outF.E_full(2:end,:), 1);

        x_pipe = x_local_pde + (q-1)*L_pde;

        x_all = [x_all, x_pipe];
        E_all = [E_all, E_avg_full];

        prev_out = outF;

    end

    [x_unique, ia] = unique(x_all, 'stable');
    E_unique = E_all(ia);

    E_dense = interp1(x_unique, E_unique, x_dense_common, 'linear', 'extrap');

    E_by_col_dense(c,:) = E_dense;

end

% Store each column and the average over columns for this EPS value
E_by_col_all_EPS(s,:,:) = E_by_col_dense;
E_mean_all_EPS(s,:) = mean(E_by_col_dense, 1);

end
end
% =========================================================
% PDE MODEL: EPS VS EFFECTIVE PERMEABILITY WITH EXPONENTIAL FIT
% ONE PANEL PER VOLUME FRACTION
% =========================================================

rho_EPS = 1500;   % kg/m^3

figure('Position',[100 100 1200 700]);

rows = ceil(n_vf/3);
cols = 3;

for j = 1:n_vf

    subplot(rows, cols, j);
    hold on; grid on; box on

    E_data = EPS_sweep(:);
    k_data = k_eff_vf_EPS(j,:).';


   E_fine = linspace(min(EPS_sweep), max(EPS_sweep), 300);

    % Linear filling model:
    % A(E) = A0(1 - E/rho_EPS)
    % Since k scales like area^2, k(E) = k(0)(1 - E/rho_EPS)^2
   Kfit = k_data(1) * max(1 - E_fine/rho_EPS, 0).^2;

    % Theory: k(E) = k(0) exp(-2E/rho_EPS)
    Ktheory = k_data(1) * max(1 - E_fine/rho_EPS, 0).^2;

     plot(E_data, k_data, 'o-', ...
            'LineWidth', 1.5, ...
            'MarkerSize', 6, ...
            'DisplayName', 'PDE data');
    
        plot(E_fine, Kfit, 'r--', ...
            'LineWidth', 2, ...
            'DisplayName', 'model: k(0)(1-E/\rho)^2');
    
        xlabel('EPS Concentration, E [kg/m^3]');
        ylabel('k(E) [m^2]');
        title(sprintf('\\phi = %.2f', vf0_values(j)));
    
        legend('Location','best','FontSize',8);

    hold off

end

sgtitle('EPS vs Effective Permeability: PDE Model');
% =========================================================
% PDE MODEL: EFFECTIVE PERMEABILITY VS BRINE VOLUME FRACTION
% ONE CURVE PER EPS CONCENTRATION
% =========================================================

figure('Position',[100 100 900 650]);
hold on; grid on; box on

% Choose EPS values to show from the PDE sweep
eps_indices = [1, round(n_sweep/4), round(n_sweep/2),n_sweep];

markerStyles = {'x', '+', 'o', 's', 'd', '^', 'v'};
lineStyles   = {'none', 'none', 'none','none','none', 'none', 'none'};

for r = 1:length(eps_indices)

    s = eps_indices(r);

    plot(vf0_values, k_eff_vf_EPS(:,s), ...
        'LineStyle', lineStyles{r}, ...
        'Marker', markerStyles{r}, ...
        'LineWidth', 2, ...
        'MarkerSize', 8, ...
        'DisplayName', sprintf('EPS = %.1f kg/m^3', EPS_sweep(s)));

end

xlabel('Brine volume fraction, \phi');
ylabel('Effective permeability, k_{eff} [m^2]');
title('Effective permeability vs brine volume fraction (PDE MODEL)');

legend('Location','northwest');

% Use log scale because permeability values are very small
set(gca,'YScale','log');

% Automatically zoom to the actual PDE permeability range
all_k = k_eff_vf_EPS(:);
all_k = all_k(isfinite(all_k) & all_k > 0);

legend('Location','northwest');
ylim([1e-13 1e-8]);   % adjust if needed
xlim([min(vf0_values)*0.8, max(vf0_values)*1.1]);
hold off

% =========================================================
% PERMEABILITY CHANGE USING EPS-LAYER CONCENTRATION PROXY
% =========================================================
n_trials = 5;

rho_EPS  = 1500;     % EPS density [kg/m^3]

D_total  = n_pipes_per_col * L;  % total vertical height of one column [m]
A_sample = n_cols * L^2;         % sample cross-sectional area [m^2]

n_EPS = 200;
EPS_con = linspace(0,rho_EPS,n_EPS)';
m = length(vf0_values);
% Store mean curves for each vf0
eff_mean_perm_plot = zeros(m,n_EPS);
eff_std_perm_plot  = zeros(m,n_EPS);

mean_area_plot = zeros(m,n_EPS);
std_area_plot  = zeros(m,n_EPS);


for j = 1:m
     vf0_current = vf0_values(j);

    % Recompute geometry statistics for this vf0
    am0 = pi*(7e-5 + 1.6e-4*vf0_current)^2;  % mean area [m^2]
    mu_A = log(am0) - 0.5*sigma_A^2;

    L = sqrt((2*am0)/vf0_current);

    D_total  = n_pipes_per_col * L;
    A_sample = n_cols * L^2;

    k_eff_all = zeros(n_EPS,n_trials);
    A_mean_all = zeros(n_EPS,n_trials);
    for trial = 1:n_trials
         % -----------------------------------------------------
        % Generate one base geometry for this trial
        % -----------------------------------------------------
        A_trial = (exp(mu_A + sigma_A*randn(1,n_pipes)))';
        
        % Store the base geometry for this trial.
        % Every EPS value starts from this same base geometry.
        A_base_trial = A_trial;
            
       
    
        for i = 1:n_EPS
         EPS_target = EPS_con(i);

    % -----------------------------------------------------
    % LINEAR EPS FILLING MODEL
    %
    % EPS_target / rho_EPS is the fraction of ORIGINAL
    % brine volume filled by EPS.
    %
    % Therefore every EPS point is computed from the same
    % base geometry, not accumulated from the previous point.
    % -----------------------------------------------------
    

    A_acc = A_base_trial .*max(1 - EPS_target/rho_EPS, 0);

    A_mean_all(i,trial) = mean(A_acc);
        
            % -----------------------------------------------------
            % 3. Compute effective permeability
            % -----------------------------------------------------
            G_col = zeros(n_cols,1);
        
            for c = 1:n_cols
        
                R_col = 0;
        
                for q = 1:n_pipes_per_col
        
                    p = (c-1)*n_pipes_per_col + q;
        
                  
                 
        
                    if A_acc(p) <= 0
                        R_pipe = Inf;
                    else
                        a_flow = sqrt(A_acc(p)/pi);
                        R_pipe = 8*mu_fluid*L/(pi*a_flow^4);
                    end
                    R_col = R_col + R_pipe;
        
                end
        
                G_col(c) = 1/R_col;
        
            end
        
            G_total = sum(G_col); %columns in parallel
        
            k_eff_all(i,trial) = mu_fluid * D_total * G_total / A_sample; %darcy equiv
        
        end
              fprintf('vf0 = %.2f | Finished permeability trial %d of %d\n', ...
            vf0_current, trial, n_trials);
    end
    
   % Average over trials for this vf0
    k_eff_mean = mean(k_eff_all, 2);
    k_eff_std  = std(k_eff_all, 0, 2);

    A_mean = mean(A_mean_all, 2);
    A_std  = std(A_mean_all, 0, 2);

    eff_mean_perm_plot(j,:) = k_eff_mean.';
    eff_std_perm_plot(j,:)  = k_eff_std.';

    mean_area_plot(j,:) = A_mean.';
    std_area_plot(j,:)  = A_std.';

    % -----------------------------------------------------
    % Exponential fit for this vf0
    % k(E) = k0 exp(-alpha E)
    % -----------------------------------------------------
   

end
% =========================================================
% EFFECTIVE PERMEABILITY VS BRINE VOLUME FRACTION
% Similar style to Zhu/Golden plot
% =========================================================

figure('Position',[100 100 850 650]);
hold on; grid on; box on

% Choose a few EPS concentrations to show
eps_indices = [1, round(n_EPS/4), round(n_EPS/2), n_EPS];

markerStyles = {'x', '+', 'o', 's', 'd', '^', 'v'};
lineStyles   = {'none', 'none', 'none','none','none', 'none', 'none'};


for r = 1:length(eps_indices)

    i = eps_indices(r);

    plot(vf0_values, eff_mean_perm_plot(:,i), ...
        'LineStyle', lineStyles{r}, ...
        'Marker', markerStyles{r}, ...
        'MarkerSize', 9, ...
        'LineWidth', 1.8, ...
        'DisplayName', sprintf('EPS = %.1f kg/m^3', EPS_con(i)));

end

set(gca, 'YScale', 'log');

xlabel('Brine volume fraction, \phi');
ylabel('Effective permeability, k_{eff} [m^2]');
title('Effective permeability vs brine volume fraction (COLUMNS MODEL)');

legend('Location','northwest');
ylim([1e-13 1e-8]);   % adjust if needed
xlim([min(vf0_values)*0.8, max(vf0_values)*1.1]);

hold off
% =========================================================
% COLUMN MODEL: EPS VS EFFECTIVE PERMEABILITY
% ONE PANEL PER vf0
% =========================================================

figure('Position',[100 100 1200 700]);

rows = ceil(m/3);
cols = 3;

for j = 1:m

    subplot(rows, cols, j);
    hold on; grid on; box on
    
    plot(EPS_con, eff_mean_perm_plot(j,:), 'o-', ...
        'LineWidth', 1.5, ...
        'DisplayName','column data');
    
    Cfine = linspace(min(EPS_con), max(EPS_con), 200);

    % Linear filling model:
    % A(E) = A0(1 - E/rho_EPS)
    % Since k scales like area^2:
    % k(E) = k(0)(1 - E/rho_EPS)^2
    Kmodel = eff_mean_perm_plot(j,1) * max(1 - Cfine/rho_EPS, 0).^2;

    plot(Cfine, Kmodel, 'r--', ...
        'LineWidth', 2, ...
        'DisplayName', 'model: k(0)(1-E/\rho)^2');
    
    xlabel('EPS Concentration, E (kg/m^3)');
    ylabel('k(E) (m^2)');
    title(sprintf('\\phi = %.2f', vf0_values(j)));

    legend('Location','best');

    hold off;

end

