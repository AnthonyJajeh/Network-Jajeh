% 
%         % Outer EPS wall
%         plot(x_shift + [ R(p)  R(p)], [y0 y1], 'k-', 'LineWidth', 1.5);
%         plot(x_shift + [-R(p) -R(p)], [y0 y1], 'k-', 'LineWidth', 1.5);
% 
%     end
% 
%     text(x_shift, -0.08*n_pipes_per_col*L_pde, sprintf('Column %d', c), ...
